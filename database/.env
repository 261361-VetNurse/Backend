# ====================================================================
# MySQL Docker Environment Variables
# Copy this file to .env and update the values
# ====================================================================

# MySQL Root Password
MYSQL_ROOT_PASSWORD=super_secret_root_password_2026

# MySQL Database
MYSQL_DATABASE=pet_medic_db

# MySQL User (non-root user)
MYSQL_USER=pet_medic_user
MYSQL_PASSWORD=secure_password_2026

# Port Mappings
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
ADMINER_PORT=8081

# ====================================================================
# Connection Strings for Application
# ====================================================================

# MySQL Connection String (for Python/FastAPI)
# DATABASE_URL=mysql+aiomysql://pet_medic_user:secure_password_2026@localhost:3306/pet_medic_db

# MySQL Connection String (for SQLAlchemy)
# MYSQL_URI=mysql+aiomysql://pet_medic_user:secure_password_2026@localhost:3306/pet_medic_db?charset=utf8mb4
