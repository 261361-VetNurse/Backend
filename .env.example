# LINE Login Configuration
CHANNEL_ID=your_channel_id
KEY_ID=your_key_id
LOGIN_CLIENT_ID=your_line_login_client_id
LOGIN_CLIENT_SECRET=your_line_login_client_secret
REDIRECT_URI=https://your-domain.com/auth/callback

# MySQL Database Configuration
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=pet_medic_user
MYSQL_PASSWORD=change_me_strong_password
MYSQL_DATABASE=pet_medic_db

# JWT Secret Key
JWT_SECRET=change_me_long_random_secret

# Cloudflare R2 Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
