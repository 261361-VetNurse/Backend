{
  "info": {
    "name": "Medications API Tests",
    "description": "Complete test collection for Medications endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token_user1",
      "value": "mock_token_user_1_long_live",
      "type": "string"
    },
    {
      "key": "access_token_user2",
      "value": "mock_token_user_2_long_live",
      "type": "string"
    },
    {
      "key": "notification_id",
      "value": "REPLACE_WITH_ACTUAL_NOTIFICATION_ID",
      "type": "string"
    },
    {
      "key": "medicine_id",
      "value": "REPLACE_WITH_ACTUAL_MEDICINE_ID",
      "type": "string"
    },
    {
      "key": "pet1_id",
      "value": "REPLACE_WITH_PET1_ID",
      "type": "string"
    },
    {
      "key": "pet2_id",
      "value": "REPLACE_WITH_PET2_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GROUP A - Notification Feed & Actions",
      "item": [
        {
          "name": "1. GET All Medications (Today, All Pets)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/medications",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications"]
            }
          },
          "response": []
        },
        {
          "name": "2. GET Medications (Filter by Pet ID)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/medications?pets_id={{pet1_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications"],
              "query": [
                {
                  "key": "pets_id",
                  "value": "{{pet1_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. GET Medications (Filter by Date)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/medications?date=2026-01-16",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-01-16"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. GET Medications (Pet + Date)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/medications?pets_id={{pet2_id}}&date=2026-01-20",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications"],
              "query": [
                {
                  "key": "pets_id",
                  "value": "{{pet2_id}}"
                },
                {
                  "key": "date",
                  "value": "2026-01-20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "5. GET Medication Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/medications/{{notification_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "{{notification_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "6. PATCH Mark as Taken (True)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"istaken\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/medications/{{notification_id}}/taken",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "{{notification_id}}", "taken"]
            }
          },
          "response": []
        },
        {
          "name": "7. PATCH Mark as Not Taken (False)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"istaken\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/medications/{{notification_id}}/taken",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "{{notification_id}}", "taken"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "GROUP B - Medicine Management",
      "item": [
        {
          "name": "1. GET Medicine Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/medications/{{notification_id}}/{{medicine_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "{{notification_id}}", "{{medicine_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "2. PATCH Edit Medicine (Name Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amoxycillin Updated\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/medications/{{notification_id}}/{{medicine_id}}/edit",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "{{notification_id}}", "{{medicine_id}}", "edit"]
            }
          },
          "response": []
        },
        {
          "name": "3. PATCH Edit Medicine (Scenario A - Schedule Change)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"frequency\": \"0,1,2,3,4\",\n  \"reminder_time\": [\"09:00\", \"21:00\"],\n  \"end_date\": \"2026-01-30T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/medications/{{notification_id}}/{{medicine_id}}/edit",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "{{notification_id}}", "{{medicine_id}}", "edit"]
            }
          },
          "response": []
        },
        {
          "name": "4. PATCH Edit Medicine (Scenario B - Stop Medicine)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"stopped\",\n  \"note\": \"Pet recovered, no longer needs medication\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/medications/{{notification_id}}/{{medicine_id}}/edit",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "{{notification_id}}", "{{medicine_id}}", "edit"]
            }
          },
          "response": []
        },
        {
          "name": "5. PATCH Delete Medicine (Cascade)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/medications/{{notification_id}}/{{medicine_id}}/delete",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "{{notification_id}}", "{{medicine_id}}", "delete"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "BONUS - Create Medicine",
      "item": [
        {
          "name": "1. POST Create Medicine (Daily)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pet_id\": \"{{pet1_id}}\",\n  \"name\": \"Heartgard Plus\",\n  \"notes\": [\"Give with food\"],\n  \"properties\": \"Heartworm prevention\",\n  \"image_urls\": [],\n  \"dosage\": \"1 chewable tablet\",\n  \"frequency\": \"daily\",\n  \"status\": \"active\",\n  \"reminder_time\": [\"08:00\"],\n  \"start_date\": \"2026-01-16T00:00:00Z\",\n  \"end_date\": \"2026-02-16T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/medications/medicine",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "medicine"]
            }
          },
          "response": []
        },
