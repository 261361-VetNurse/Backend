        {
          "name": "3. POST Create Medicine (Weekly)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "access_token",
                "value": "{{access_token_user1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pet_id\": \"{{pet1_id}}\",\n  \"name\": \"Flea & Tick Prevention\",\n  \"notes\": [\"Apply to back of neck\"],\n  \"properties\": \"Topical parasite prevention\",\n  \"image_urls\": [],\n  \"dosage\": \"1 tube\",\n  \"frequency\": \"weekly\",\n  \"status\": \"active\",\n  \"reminder_time\": [\"09:00\"],\n  \"start_date\": \"2026-01-20T00:00:00Z\",\n  \"end_date\": \"2026-04-20T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/medications/medicine",
              "host": ["{{base_url}}"],
              "path": ["v1", "medications", "medicine"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "ERROR CASES - Test Authorization & Validation",
      "item": [
